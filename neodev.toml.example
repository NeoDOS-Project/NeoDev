# NeoDev Configuration Example
# Copy to ~/.config/neodev/neodev.toml or <neodos_root>/neodev.toml

[project]
esp_size_mb = 100
neodos_size_mb = 100
gpt_padding_mb = 12
kernel_target = "x86_64-unknown-none"
bootloader_target = "x86_64-unknown-uefi"

[vm]
backend = "qemu"
memory = 512
cpus = 2
network = "user"

[qemu]
kvm = false
bdm = false
ovmf_code = "/usr/share/OVMF/OVMF_CODE.fd"
ovmf_vars_template = "/usr/share/OVMF/OVMF_VARS.fd"

# VirtualBox backend settings (ignored by QEMU)
[virtualbox]
headless = false        # same as passing --headless
vrde = false            # enable the built-in RDP server
vrde_port = 5000
vrde_address = "0.0.0.0"
# vrde_certificate = "/path/to/server.crt"   # optional PEM cert for RDP TLS
# vrde_private_key = "/path/to/server.key"    # optional PEM key for RDP TLS
